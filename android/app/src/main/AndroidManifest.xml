<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限说明：
        · 网络权限（INTERNET）：只在你主动点「检查更新」（或开启启动时自动检查）时用，
          向 Gitee / GitHub 读一个公开的版本号；点了更新之后，再从同一个发布页下载
          安装包本身。除此之外不联网——识别、打码、保存全在本机完成，不传文件、
          不传任何个人信息，也没有后台联网。
        · 安装应用（REQUEST_INSTALL_PACKAGES）：只用于一件事——更新时把下载好的
          新版本交给系统安装器。系统会再问你一次「是否安装」，你不点就不会装。
          之所以要自己下载：Gitee 的安装包附件返回的类型是 application/zip，
          浏览器会把文件存成「xxx.apk.zip」，用户点了装不上，只能由应用自己下。
        · 选文件走系统文件选择器（SAF），只拿到用户主动挑中的那一个文件的临时读权限
        · 存文件走系统「另存为」，写到哪里由用户当场决定
      因此没有存储权限、没有定位权限、没有后台服务。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfMask">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从文件管理器「打开方式」直接选本应用 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- 其它应用「分享」PDF 过来 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- 更新时把缓存目录里的安装包交给系统安装器；只暴露 cache/update/ 这一层 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.neurotracee.pdfmask.updatefile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
