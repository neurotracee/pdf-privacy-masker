# 构建产物
build/
dist/
*.spec.bak
# 发版暂存：release/<版本>/ 里放的是要往 Release 页面拖的 exe/apk，不进仓库
release/

# 运行时与临时文件
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp

# 本机路径配置（各人机器不同，不入仓库）
dev/.local_copy_target

# 本地测试输出（不进入仓库）
_shots/
dev/_ui/
*.log

# ---- 安卓端（android/ 内另有 .gitignore，这里再兜一层）----
.gradle/
app/build/
captures/
local.properties
*.apk
*.aab

# ---- 签名文件一律不进仓库 ----
*.jks
*.keystore
keystore.properties
signing.properties

# ---- 自检 / 测试产物（dev/selfcheck.py 默认写到临时目录，这里再兜一层）----
test/*_打码后.pdf
test/after_p*.png
test/zoom_*.png
test/rot90*.pdf
test/_fp.pdf
test/误报_*.pdf
test/blind/
test/h25/
test/h30/
test/*_已打码.pdf
